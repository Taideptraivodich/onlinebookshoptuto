<!DOCTYPE html>
<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>@ViewData["Title"] - Book shop</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap.min.css" />
	</head>
	<body>
		<nav class="navbar navbar-expand navbar-dark bg-success">
			<div class="container">
				<a class="navbar-brand" asp-controller="Books" asp-action="Index">
					<i class="bi bi-book"></i> Book Shop
				</a>
				<ul class="navbar-nav">
					<li class="nav-item">
						<a class="nav-link" asp-controller="Books" asp-action="Index">Danh sách sách</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" asp-controller="Books" asp-action="Create">Thêm</a>
					</li>
				</ul>
			</div>
		</nav>

		<main class="container mt-4">
			@RenderBody()
		</main>

		<footer class="container text-center text-muted my-5">
			&copy; 2026 Book Shop
		</footer>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</body>
</html>