@model IEnumerable<OnlineBookShopTuto.Models.Book>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <title>Danh sách sách</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    </head>

    <body>
        <div class="container mt-4">
        <h2>Danh sách sách</h2>
        <a asp-action="Create" class="btn btn-primary mb-3">+ Thêm sách</a>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Tên sách</th>
                    <th>Tác giả</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Tồn kho</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Category?.Name</td>
                        <td>@book.Price.ToString("N0") đ</td>
                        <td>@book.Stock</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">Xoá</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
            
        </div>
    </body>
</html>